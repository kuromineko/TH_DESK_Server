<Window x:Class="TH_DESK_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TH_DESK Server Manager" Height="650" Width="780"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <!-- สไตล์ช่องกรอกข้อความ -->
        <Style x:Key="ModernInput" TargetType="TextBox">
            <Setter Property="Background" Value="#10131C"/>
            <Setter Property="Foreground" Value="#F3F4F6"/>
            <Setter Property="CaretBrush" Value="#0071FF"/>
            <Setter Property="BorderBrush" Value="#2A3042"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#0071FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- สไตล์ปุ่มกดทั่วไป -->
        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- สไตล์ปุ่มเมนูด้านซ้าย (Sidebar) -->
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="navBorder" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="navBorder" Property="Background" Value="#1E2536"/>
                                <Setter TargetName="navBorder" Property="TextBlock.Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- กรอบหน้าต่างหลัก -->
    <Border Background="#0F121A" BorderBrush="#252B3B" BorderThickness="1" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. แถบหัวหน้าต่าง (Title Bar) -->
            <Border Grid.Row="0" Background="#141824" CornerRadius="14,14,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid Margin="18,0,12,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                               Width="28" Height="28" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="TH_DESK" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="SERVER (x64)" Foreground="#64748B" FontWeight="SemiBold" FontSize="11.5"
                                   Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnLangToggle" Content="🌐 ภาษา: TH" Width="88" Height="26"
                                Background="#1E293B" Foreground="#38BDF8" Margin="0,0,10,0"
                                Style="{StaticResource ModernButton}" Click="BtnLangToggle_Click"/>

                        <Border Background="#1E2433" CornerRadius="12" Padding="10,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="#64748B" Margin="0,0,6,0"/>
                                <TextBlock x:Name="txtHeaderStatus" Text="Offline" Foreground="#94A3B8" FontSize="11.5" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>

                        <Button Content="—" Width="32" Height="28" Background="Transparent" Foreground="#94A3B8"
                                Style="{StaticResource ModernButton}" Click="BtnMinimize_Click"/>
                        <Button Content="✕" Width="32" Height="28" Background="Transparent" Foreground="#94A3B8"
                                Style="{StaticResource ModernButton}" Click="BtnClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. พื้นที่หลัก แบ่ง Sidebar ซ้าย และ เนื้อหาขวา -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="185"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- แถบเมนูซ้าย (Sidebar) -->
                <Border Grid.Column="0" Background="#131722" BorderBrush="#1F2433" BorderThickness="0,0,1,0" CornerRadius="0,0,0,14" Padding="12,16">
                    <Grid>
                        <StackPanel>
                            <Button x:Name="navDashboard" Content="🖥  หน้าหลัก Server" Style="{StaticResource NavButton}"
                                    Background="#0071FF" Foreground="White" Click="NavDashboard_Click"/>
                            <Button x:Name="navSettings" Content="⚙  ตั้งค่าระบบ" Style="{StaticResource NavButton}"
                                    Click="NavSettings_Click"/>
                            <Button x:Name="navAbout" Content="ℹ  เกี่ยวกับโปรแกรม" Style="{StaticResource NavButton}"
                                    Click="NavAbout_Click"/>
                        </StackPanel>

                        <StackPanel VerticalAlignment="Bottom" Margin="6,0,0,4">
                            <TextBlock Text="TH_DESK Community" Foreground="#475569" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock Text="AGPL-3.0 Open Source" Foreground="#334155" FontSize="10.5"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- พื้นที่เนื้อหาขวา (สลับ 3 หน้า) -->
                <Grid Grid.Column="1" Margin="18,14,18,16">

                    <!-- ==================== หน้าที่ 1: DASHBOARD ==================== -->
                    <StackPanel x:Name="pageDashboard" Visibility="Visible">
                        <!-- การ์ด DDNS -->
                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="230"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblDdnsTitle" Text="1. โดเมน DDNS หรือ Public IP ของคุณ" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock x:Name="lblDdnsSub" Text="ที่อยู่สำหรับให้เครื่องปลายทางเชื่อมต่อเข้ามาจากภายนอก" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBox x:Name="txtDdns" Grid.Column="1" Text="your-ddns.thddns.net" Style="{StaticResource ModernInput}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- การ์ดตั้งค่า Port (ID & Relay) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ID Server -->
                            <Border Grid.Column="0" Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="lblIdServerTitle" Text="2. ID Server (hbbs)" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="TCP + UDP" Foreground="#38BDF8" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock x:Name="lblIdInPort" Text="IN Port (ในเครื่อง):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="txtIdIn" Text="21116" Width="85" HorizontalAlignment="Right" Style="{StaticResource ModernInput}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="lblIdOutPort" Text="Out Port (พอร์ตนอก):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="txtIdOut" Text="21116" Width="85" HorizontalAlignment="Right" Style="{StaticResource ModernInput}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Relay Server -->
                            <Border Grid.Column="2" Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="12">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <TextBlock x:Name="lblRelayServerTitle" Text="3. Relay Server (hbbr)" Foreground="#A78BFA" FontWeight="Bold" FontSize="12.5"/>
                                        <Border Background="#1E293B" CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                                            <TextBlock Text="TCP Only" Foreground="#A78BFA" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </DockPanel>
                                    <Grid Margin="0,0,0,6">
                                        <TextBlock x:Name="lblRelayInPort" Text="IN Port (ในเครื่อง):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="txtRelayIn" Text="21117" Width="85" HorizontalAlignment="Right" Style="{StaticResource ModernInput}"/>
                                    </Grid>
                                    <Grid>
                                        <TextBlock x:Name="lblRelayOutPort" Text="Out Port (พอร์ตนอก):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12"/>
                                        <TextBox x:Name="txtRelayOut" Text="21117" Width="85" HorizontalAlignment="Right" Style="{StaticResource ModernInput}"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- ปุ่มเปิดระบบ & เช็คพอร์ต -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="155"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="btnToggle" Grid.Column="0" Content="▶  เปิดระบบ Server + เปิด Firewall"
                                    Height="42" Background="#10B981" Style="{StaticResource ModernButton}" Click="BtnToggle_Click"/>
                            <Button x:Name="btnCheckPort" Grid.Column="2" Content="⚡ เช็คพอร์ต"
                                    Height="42" Background="#0071FF" Style="{StaticResource ModernButton}" Click="BtnCheckPort_Click"/>
                        </Grid>

                        <TextBlock x:Name="lblStatus" Text="พร้อมทำงาน — กดปุ่มเปิดระบบเพื่อคลายไฟล์และเริ่มการทำงานของ Server ได้ทันที"
                                   Foreground="#94A3B8" FontSize="11.5" Margin="2,0,0,10" TextTrimming="CharacterEllipsis"/>

                        <!-- การ์ดแสดง Key และ Config -->
                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="12">
                            <StackPanel>
                                <TextBlock x:Name="lblPubKeyTitle" Text="Public Key (สร้างอัตโนมัติจาก id_ed25519.pub)" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                <TextBox x:Name="txtPubKey" IsReadOnly="True" Text="-" Style="{StaticResource ModernInput}"
                                         Foreground="#38BDF8" FontFamily="Consolas" FontSize="12" Margin="0,0,0,8"/>

                                <TextBlock x:Name="lblClientConfigTitle" Text="ข้อมูลสำหรับนำไปใส่ในโปรแกรม TH_DESK (ฝั่งผู้ใช้งาน)" Foreground="#94A3B8" FontSize="11.5" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="145"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox AcceptsReturn="True" FontFamily="Consolas" FontSize="11.5" Grid.Column="0" Height="74" IsReadOnly="True" Style="{StaticResource ModernInput}" TextWrapping="Wrap" x:Name="txtClientConfig"/>
                                    <StackPanel Grid.Column="2">
                                        <Button Background="#262F45" Click="BtnCopy_Click" Content="📋 คัดลอกค่า" Height="34" Margin="0,0,0,6" Style="{StaticResource ModernButton}" x:Name="btnCopy"/>
                                        <Button Background="#0071FF" Click="BtnExportClient_Click" Content="📥 ส่งออกไฟล์ลูกข่าย" Height="34" Style="{StaticResource ModernButton}" x:Name="btnExportClient"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== หน้าที่ 2: SETTINGS ==================== -->
                    <StackPanel x:Name="pageSettings" Visibility="Collapsed">
                        <TextBlock x:Name="lblSettingsHeader" Text="ตั้งค่าระบบ (System Settings)" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblSettingsSub" Text="กำหนดภาษา พฤติกรรมการเปิดพอร์ต และการจัดการไฟล์ระบบของ TH_DESK Server" Foreground="#64748B" FontSize="12" Margin="0,0,0,16"/>

                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                            <Grid>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="lblLangSettingTitle" Text="ภาษาที่แสดงผล (Display Language)" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13.5"/>
                                    <TextBlock x:Name="lblLangSettingDesc" Text="สลับภาษาเมนูและข้อความแจ้งเตือนระหว่าง ภาษาไทย และ English" Foreground="#64748B" FontSize="11.5" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button x:Name="btnLangTH" Content="🇹🇭 ภาษาไทย" Width="95" Height="34" Margin="0,0,8,0"
                                            Background="#0071FF" Style="{StaticResource ModernButton}" Click="BtnSetLangTH_Click"/>
                                    <Button x:Name="btnLangEN" Content="🇬🇧 English" Width="95" Height="34"
                                            Background="#262F45" Style="{StaticResource ModernButton}" Click="BtnSetLangEN_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Margin="0,0,0,12" Padding="16,14">
                            <StackPanel>
                                <CheckBox Click="ChkAutoStartBoot_Click" Content="เปิดโปรแกรมและรันระบบ Server อัตโนมัติเมื่อเปิดเครื่อง Windows (Auto-Start on Boot)" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" IsChecked="False" Margin="0,0,0,10" x:Name="chkAutoStartBoot"/>
                                <CheckBox Content="พับเก็บลงมุมขวาล่างข้างนาฬิกา (System Tray) เมื่อกดปุ่มย่อหน้าต่าง" FontSize="13" Foreground="#E2E8F0" IsChecked="True" Margin="0,0,0,10" x:Name="chkMinimizeToTray"/>
                                <CheckBox Content="เปิดพอร์ตใน Windows Firewall อัตโนมัติทุกครั้งที่กดเริ่มระบบ Server" FontSize="13" Foreground="#E2E8F0" IsChecked="True" Margin="0,0,0,10" x:Name="chkAutoFirewall"/>
                                <CheckBox Content="บันทึกค่า DDNS และหมายเลข Port อัตโนมัติเมื่อกดเปิดระบบ" FontSize="13" Foreground="#E2E8F0" IsChecked="True" Margin="0,0,0,10" x:Name="chkSaveConfig"/>
                                <CheckBox Content="ปิดโปรเซส hbbs.exe และ hbbr.exe อัตโนมัติเมื่อกดปิดโปรแกรมนี้" FontSize="13" Foreground="#E2E8F0" IsChecked="True" x:Name="chkKillOnExit"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="lblFolderSettingTitle" Text="การจัดการไฟล์ Server และรหัสความปลอดภัย (Key Management)" Foreground="#F1F5F9" FontWeight="SemiBold" FontSize="13.5" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnOpenFolder" Grid.Column="0" Content="📂 เปิดโฟลเดอร์เก็บไฟล์ Server" Height="38"
                                            Background="#262F45" Style="{StaticResource ModernButton}" Click="BtnOpenFolder_Click"/>
                                    <Button x:Name="btnResetKey" Grid.Column="2" Content="🔑 ลบและสร้าง Public Key ใหม่" Height="38"
                                            Background="#B91C1C" Style="{StaticResource ModernButton}" Click="BtnResetKey_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- ==================== หน้าที่ 3: ABOUT ==================== -->
                    <StackPanel x:Name="pageAbout" Visibility="Collapsed">
                        <TextBlock x:Name="lblAboutHeader" Text="เกี่ยวกับ TH_DESK (About &amp; Open Source Credits)" Foreground="White" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock x:Name="lblAboutDesc" Text="โปรแกรมรีโมทเดสก์ท็อปและตัวจัดการเซิร์ฟเวอร์แบบโอเพนซอร์ส แจกจ่ายฟรีสำหรับทุกคน" Foreground="#64748B" FontSize="12" Margin="0,0,0,14"/>

                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="16,14" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock x:Name="lblCreatorTitle" Text="ผู้พัฒนาและดูแลโปรเจกต์ (Developer &amp; Maintainer)" Foreground="#38BDF8" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblCreatorName" Text="• พัฒนาและดูแลโปรเจกต์โดย: kuromineko" Foreground="#F1F5F9" FontSize="13" Margin="0,0,0,4"/>
                                <TextBlock x:Name="lblCreatorRepo" Text="• ซอร์สโค้ด TH_DESK: https://github.com/kuromineko/TH_DESK" Foreground="#94A3B8" FontSize="12.5" Margin="0,0,0,10"/>
                                <Button x:Name="btnOpenMyGithub" Content="🔗 เปิดหน้า GitHub ของ TH_DESK (kuromineko/TH_DESK)" Height="36"
                                        Background="#0071FF" Style="{StaticResource ModernButton}" Click="BtnOpenMyGithub_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#171B26" BorderBrush="#23293A" BorderThickness="1" CornerRadius="10" Padding="16,14">
                            <StackPanel>
                                <TextBlock x:Name="lblSourceTitle" Text="ที่มาของซอร์สโค้ดต้นฉบับและสัญญาอนุญาต (Upstream &amp; License)" Foreground="#A78BFA" FontWeight="Bold" FontSize="13.5" Margin="0,0,0,6"/>
                                <TextBlock x:Name="lblLicenseNotice" TextWrapping="Wrap" Foreground="#CBD5E1" FontSize="12.5" LineHeight="19" Margin="0,0,0,12"
                                           Text="โปรแกรม TH_DESK พัฒนาต่อยอดจากโปรเจกต์โอเพนซอร์ส RustDesk และทำงานร่วมกับคอร์เซิร์ฟเวอร์ RustDesk Server OSS (hbbs / hbbr) เผยแพร่ภายใต้สัญญาอนุญาตสาธารณะ GNU Affero General Public License v3.0 (AGPL-3.0) โดยเปิดเผยซอร์สโค้ดและแจกจ่ายให้ใช้งานได้ฟรี"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="btnOpenRustDeskGithub" Grid.Column="0" Content="🌐 โค้ดต้นฉบับ RustDesk Official" Height="36"
                                            Background="#262F45" Style="{StaticResource ModernButton}" Click="BtnOpenRustDesk_Click"/>
                                    <Button x:Name="btnOpenLicense" Grid.Column="2" Content="📜 อ่านสัญญาอนุญาต AGPL-3.0" Height="36"
                                            Background="#262F45" Style="{StaticResource ModernButton}" Click="BtnOpenLicense_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>