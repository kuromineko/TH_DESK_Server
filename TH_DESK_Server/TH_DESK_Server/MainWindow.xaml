<Window x:Class="TH_DESK_Server.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TH_DESK Server Manager (Enterprise Edition)"
        Width="980" Height="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanMinimize">

    <Border Background="#0B0E14" CornerRadius="14" BorderBrush="#1E2536" BorderThickness="1.5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="54"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ==================== TITLE BAR ==================== -->
            <Border Grid.Row="0" Background="#111520" CornerRadius="14,14,0,0" BorderBrush="#1E2536" BorderThickness="0,0,0,1" MouseDown="TitleBar_MouseDown">
                <Grid Margin="18,0,14,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- ดึงไอคอน .ico ของโปรแกรมมาแสดงที่มุมซ้ายบนอัตโนมัติ -->
                        <Image Source="{Binding Icon, RelativeSource={RelativeSource AncestorType=Window}}"
                               Width="28" Height="28" Margin="0,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="TH_DESK" FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
                        <TextBlock Text="SERVER PRO CONSOLE" FontSize="11.5" FontWeight="SemiBold" Foreground="#38BDF8" Margin="8,2,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <!-- ปุ่มเปิด Web Dashboard -->
                        <Button x:Name="btnOpenWebTop" Content="🌐 Web Console :8080" Click="BtnOpenWeb_Click"
                                Background="#172033" Foreground="#38BDF8" BorderBrush="#0071FF" BorderThickness="1"
                                Padding="12,5" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- ปุ่มสลับภาษา -->
                        <Button x:Name="btnLangToggle" Content="🌐 ภาษา: TH" Click="BtnLangToggle_Click"
                                Background="#1A2030" Foreground="#E2E8F0" BorderThickness="0"
                                Padding="12,5" Margin="0,0,10,0" Cursor="Hand" FontWeight="SemiBold" FontSize="11.5">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- สถานะ Online/Offline -->
                        <Border Background="#151B28" BorderBrush="#252E42" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="#64748B" Margin="0,0,7,0"/>
                                <TextBlock x:Name="txtHeaderStatus" Text="Offline" FontSize="12" FontWeight="Bold" Foreground="#94A3B8"/>
                            </StackPanel>
                        </Border>

                        <Button Content="—" Click="BtnMinimize_Click" Width="32" Height="28" Background="Transparent" Foreground="#94A3B8" BorderThickness="0" Cursor="Hand" FontSize="13"/>
                        <Button Content="✕" Click="BtnClose_Click" Width="32" Height="28" Background="Transparent" Foreground="#EF4444" BorderThickness="0" Cursor="Hand" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ==================== BODY ==================== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="225"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT SIDEBAR -->
                <Border Grid.Column="0" Background="#10141F" BorderBrush="#1E2536" BorderThickness="0,0,1,0" CornerRadius="0,0,0,14">
                    <Grid>
                        <StackPanel Margin="14,18,14,14">
                            <Button x:Name="navDashboard" Content="🖥  หน้าหลัก Server" Click="NavDashboard_Click"
                                    Height="42" Background="#0071FF" Foreground="White" FontWeight="SemiBold" FontSize="13.5"
                                    HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="navMonitor" Content="📡  เครื่องที่เชื่อมต่อ (Live)" Click="NavMonitor_Click"
                                    Height="42" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13.5"
                                    HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="navSettings" Content="⚙  ตั้งค่าระบบ" Click="NavSettings_Click"
                                    Height="42" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13.5"
                                    HorizontalContentAlignment="Left" Padding="14,0" Margin="0,0,0,8" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button x:Name="navAbout" Content="ℹ  เกี่ยวกับโปรแกรม" Click="NavAbout_Click"
                                    Height="42" Background="Transparent" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="13.5"
                                    HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" BorderThickness="0">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>

                        <!-- Quick Web Status Card at Bottom Left -->
                        <Border VerticalAlignment="Bottom" Margin="14,0,14,58" Background="#151B29" BorderBrush="#232C42" BorderThickness="1" CornerRadius="10" Padding="12,10">
                            <StackPanel>
                                <TextBlock Text="🌐 WEB DASHBOARD" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                <TextBlock x:Name="lblWebUrlSidebar" Text="http://localhost:8080" FontSize="11.5" Foreground="#CBD5E1" Margin="0,3,0,6"/>
                                <Button x:Name="btnOpenWebSidebar" Content="เปิดดูบนเบราว์เซอร์ ↗" Click="BtnOpenWeb_Click"
                                        Height="26" Background="#0071FF" Foreground="White" FontSize="11" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>

                        <StackPanel VerticalAlignment="Bottom" Margin="18,0,14,16">
                            <TextBlock Text="TH_DESK Enterprise Server" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="AGPL-3.0 Open Source" FontSize="10.5" Foreground="#475569"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== RIGHT CONTENT PAGES ==================== -->
                <Grid Grid.Column="1" Margin="22,16,22,16">

                    <!-- PAGE 1: DASHBOARD -->
                    <ScrollViewer x:Name="pageDashboard" VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <StackPanel>
                            <!-- 4 LIVE TELEMETRY CARDS -->
                            <UniformGrid Columns="4" Margin="0,0,0,14">
                                <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock x:Name="lblStatPeersTitle" Text="🟢 เครื่องที่ออนไลน์" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="txtStatOnlinePeers" Text="0" FontSize="22" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock x:Name="lblStatTunnelsTitle" Text="⚡ ท่อที่กำลังเชื่อม" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="txtStatActiveTunnels" Text="0" FontSize="22" FontWeight="Bold" Foreground="#38BDF8" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="4,0,4,0">
                                    <StackPanel>
                                        <TextBlock x:Name="lblStatTrafficTitle" Text="📊 ข้อมูลสะสม (Traffic)" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="txtStatTraffic" Text="0 KB" FontSize="20" FontWeight="Bold" Foreground="#A78BFA" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="8,0,0,0">
                                    <StackPanel>
                                        <TextBlock x:Name="lblStatUptimeTitle" Text="⏱ เวลาทำงาน (Uptime)" FontSize="11" Foreground="#94A3B8"/>
                                        <TextBlock x:Name="txtStatUptime" Text="00:00:00" FontSize="20" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- 1. DDNS / IP & Web Port -->
                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="230"/>
                                        <ColumnDefinition Width="115"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="lblDdnsTitle" Text="1. โดเมน DDNS หรือ Public IP ของคุณ" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock x:Name="lblDdnsSub" Text="ที่อยู่สำหรับให้เครื่องปลายทางเชื่อมต่อและเปิดหน้า Web Console" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBox x:Name="txtDdns" Grid.Column="1" Text="mjcomputer.thddns.net" Height="34" VerticalContentAlignment="Center"
                                             Background="#0C0F17" Foreground="#38BDF8" BorderBrush="#2A344B" BorderThickness="1" Padding="10,0" FontSize="13.5" FontWeight="SemiBold" Margin="8,0"/>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="Web:" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12" Margin="0,0,5,0"/>
                                        <TextBox x:Name="txtWebPort" Text="8080" Width="68" Height="34" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 Background="#0C0F17" Foreground="#10B981" BorderBrush="#2A344B" BorderThickness="1" FontSize="13.5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- 2 & 3. ID SERVER & RELAY SERVER -->
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- ID Server -->
                                <Border Grid.Column="0" Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock x:Name="lblIdServerTitle" Text="2. ID Server (hbbs)" FontSize="13.5" FontWeight="Bold" Foreground="#38BDF8" VerticalAlignment="Center"/>
                                            <Border Background="#172A45" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="TCP + UDP" FontSize="10.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="lblIdInPort" Text="IN Port (ในเครื่อง):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12.5"/>
                                            <TextBox x:Name="txtIdIn" Text="4997" Width="110" Height="32" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="#0C0F17" Foreground="White" BorderBrush="#2A344B" FontSize="13.5" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="lblIdOutPort" Text="Out Port (พอร์ตนอก):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12.5"/>
                                            <TextBox x:Name="txtIdOut" Text="4997" Width="110" Height="32" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="#0C0F17" Foreground="White" BorderBrush="#2A344B" FontSize="13.5" FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Relay Server -->
                                <Border Grid.Column="2" Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10">
                                            <TextBlock x:Name="lblRelayServerTitle" Text="3. Relay Server (hbbr)" FontSize="13.5" FontWeight="Bold" Foreground="#A78BFA" VerticalAlignment="Center"/>
                                            <Border Background="#271E45" CornerRadius="6" Padding="8,3" HorizontalAlignment="Right">
                                                <TextBlock Text="TCP Only" FontSize="10.5" FontWeight="Bold" Foreground="#A78BFA"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock x:Name="lblRelayInPort" Text="IN Port (ในเครื่อง):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12.5"/>
                                            <TextBox x:Name="txtRelayIn" Text="4998" Width="110" Height="32" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="#0C0F17" Foreground="White" BorderBrush="#2A344B" FontSize="13.5" FontWeight="Bold"/>
                                        </Grid>
                                        <Grid>
                                            <TextBlock x:Name="lblRelayOutPort" Text="Out Port (พอร์ตนอก):" Foreground="#94A3B8" VerticalAlignment="Center" FontSize="12.5"/>
                                            <TextBox x:Name="txtRelayOut" Text="4998" Width="110" Height="32" HorizontalAlignment="Right" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                     Background="#0C0F17" Foreground="White" BorderBrush="#2A344B" FontSize="13.5" FontWeight="Bold"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- ACTION BUTTONS -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="170"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="btnToggle" Grid.Column="0" Content="▶  เปิดระบบ Server + Web Console + เปิด Firewall" Click="BtnToggle_Click"
                                        Height="44" Background="#10B981" Foreground="White" FontWeight="Bold" FontSize="14.5" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button x:Name="btnCheckPort" Grid.Column="2" Content="⚡ เช็คพอร์ต" Click="BtnCheckPort_Click"
                                        Height="44" Background="#0071FF" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>

                            <TextBlock x:Name="lblStatus" Text="พร้อมทำงาน — รองรับทั้ง UDP Direct (P2P), TCP Bridge และ Web Console"
                                       FontSize="12.5" FontWeight="SemiBold" Foreground="#94A3B8" Margin="4,0,0,10"/>

                            <!-- PUBLIC KEY & CLIENT EXPORT -->
                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="16,12">
                                <StackPanel>
                                    <TextBlock x:Name="lblPubKeyTitle" Text="Public Key (สร้างอัตโนมัติจาก id_ed25519.pub)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <TextBox x:Name="txtPubKey" Text="-" IsReadOnly="True" Height="32" VerticalContentAlignment="Center"
                                             Background="#0C0F17" Foreground="#38BDF8" BorderBrush="#2A344B" Padding="10,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <TextBlock x:Name="lblClientConfigTitle" Text="ข้อมูลสำหรับนำไปใส่ในโปรแกรม TH_DESK (ฝั่งผู้ใช้งาน)" FontSize="12" Foreground="#94A3B8" Margin="0,0,0,5"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="165"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="txtClientConfig" Grid.Column="0" Height="74" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Background="#0C0F17" Foreground="#E2E8F0" BorderBrush="#2A344B" Padding="10,6" FontSize="12" FontFamily="Consolas"/>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Button x:Name="btnCopy" Content="📋 คัดลอกค่า" Click="BtnCopy_Click" Height="33" Background="#252E42" Foreground="White" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,0,8" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                            <Button x:Name="btnExportClient" Content="📥 ส่งออกไฟล์ลูกข่าย" Click="BtnExportClient_Click" Height="33" Background="#0071FF" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PAGE 2: LIVE MONITOR & LOGS -->
                    <Grid x:Name="pageMonitor" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="175"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock x:Name="lblMonitorHeader" Text="📡 เครื่องที่เชื่อมต่อออนไลน์ (Connected Peers)" FontSize="16.5" FontWeight="Bold" Foreground="#F8FAFC"/>
                                <TextBlock x:Name="lblMonitorSub" Text="แสดงรายการเครื่องลูกข่ายที่ติดต่อผ่านเซิร์ฟเวอร์แบบเรียลไทม์" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="🌐 เปิดบนเว็บเบราว์เซอร์" Click="BtnOpenWeb_Click" Height="32" Padding="12,0" Margin="0,0,8,0" Background="#0071FF" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Button Content="🧹 ล้างรายการที่ออฟไลน์" Click="BtnClearPeers_Click" Height="32" Padding="12,0" Background="#252E42" Foreground="#E2E8F0" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- ตารางแสดงเครื่องที่เชื่อมต่อ (Dark Theme 100%) -->
                        <Border Grid.Row="1" Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,12">
                            <DataGrid x:Name="gridPeers" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="#141926" BorderThickness="0" RowBackground="#10141F" AlternatingRowBackground="#141926"
                                      Foreground="#F8FAFC" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#1E2536"
                                      HeadersVisibility="Column" RowHeight="36" FontSize="13">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="#1A2133"/>
                                        <Setter Property="Foreground" Value="#38BDF8"/>
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Padding" Value="12,8"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                        <Setter Property="BorderBrush" Value="#252E42"/>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="Padding" Value="10,0"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="สถานะ (Status)" Binding="{Binding StatusText}" Width="115"/>
                                    <DataGridTextColumn Header="หมายเลขเครื่อง (Peer ID)" Binding="{Binding PeerId}" Width="145"/>
                                    <DataGridTextColumn Header="IP Address ต้นทาง" Binding="{Binding IpAddress}" Width="145"/>
                                    <DataGridTextColumn Header="โหมดการเชื่อมต่อ (Mode)" Binding="{Binding Mode}" Width="150"/>
                                    <DataGridTextColumn Header="อัปเดตล่าสุด (Last Seen)" Binding="{Binding LastSeenText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- กล่อง Live Event Logs -->
                        <Border Grid.Row="2" Background="#0C0F17" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="📋 บันทึกเหตุการณ์เซิร์ฟเวอร์แบบเรียลไทม์ (Real-Time Server Logs)" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,6"/>
                                <TextBox x:Name="txtServerLogs" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         Background="Transparent" Foreground="#94A3B8" BorderThickness="0" FontFamily="Consolas" FontSize="11.5"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- PAGE 3: SETTINGS -->
                    <ScrollViewer x:Name="pageSettings" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="lblSettingsHeader" Text="ตั้งค่าระบบ (System Settings)" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="lblSettingsSub" Text="กำหนดภาษา พฤติกรรมการเปิดพอร์ต ระบบ Watchdog และการจัดการไฟล์ระบบ" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,16"/>

                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                                <Grid>
                                    <StackPanel>
                                        <TextBlock x:Name="lblLangSettingTitle" Text="ภาษาที่แสดงผล (Display Language)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC"/>
                                        <TextBlock x:Name="lblLangSettingDesc" Text="สลับภาษาเมนูและข้อความแจ้งเตือนระหว่าง ภาษาไทย และ English" FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button x:Name="btnLangTH" Content="🇹🇭 ภาษาไทย" Click="BtnSetLangTH_Click" Width="100" Height="32" Background="#0071FF" Foreground="White" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand" BorderThickness="0"/>
                                        <Button x:Name="btnLangEN" Content="🇬🇧 English" Click="BtnSetLangEN_Click" Width="100" Height="32" Background="#262F45" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
                                <StackPanel>
                                    <CheckBox x:Name="chkAutoStartBoot" Content="เปิดโปรแกรมและรันระบบ Server อัตโนมัติเมื่อเปิดเครื่อง Windows (Auto-Start on Boot)"
                                              Click="ChkAutoStartBoot_Click" Foreground="#E2E8F0" FontSize="13" Margin="0,4,0,10"/>
                                    <CheckBox x:Name="chkMinimizeToTray" Content="พับเก็บลงมุมขวาล่างข้างนาฬิกา (System Tray) เมื่อกดปุ่มย่อหน้าต่าง"
                                              IsChecked="True" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkEnableWebConsole" Content="เปิดระบบ Web Console Dashboard (ให้เช็คสถานะผ่านเว็บเบราว์เซอร์และมือถือได้)"
                                              IsChecked="True" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkAutoRestartWatchdog" Content="เปิดระบบ Auto-Heal Watchdog (สั่งรัน hbbs/hbbr ใหม่อัตโนมัติหากโปรเซสหลุด)"
                                              IsChecked="True" Foreground="#10B981" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkAutoFirewall" Content="เปิดพอร์ตใน Windows Firewall อัตโนมัติทุกครั้งที่กดเริ่มระบบ Server"
                                              IsChecked="True" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkSaveConfig" Content="บันทึกค่า DDNS และหมายเลข Port อัตโนมัติเมื่อกดเปิดระบบ"
                                              IsChecked="True" Foreground="#E2E8F0" FontSize="13" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="chkKillOnExit" Content="ปิดโปรเซส hbbs.exe และ hbbr.exe อัตโนมัติเมื่อกดปิดโปรแกรมนี้"
                                              IsChecked="True" Foreground="#E2E8F0" FontSize="13"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="18,14">
                                <StackPanel>
                                    <TextBlock x:Name="lblFolderSettingTitle" Text="การจัดการไฟล์ Server และรหัสความปลอดภัย (Key Management)" FontSize="14" FontWeight="Bold" Foreground="#F8FAFC" Margin="0,0,0,12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnOpenFolder" Content="📂 เปิดโฟลเดอร์เก็บไฟล์ Server" Click="BtnOpenFolder_Click" Height="36" Padding="16,0" Background="#252E42" Foreground="White" FontWeight="SemiBold" Margin="0,0,12,0" Cursor="Hand" BorderThickness="0"/>
                                        <Button x:Name="btnResetKey" Content="🔑 ลบและสร้าง Public Key ใหม่" Click="BtnResetKey_Click" Height="36" Padding="16,0" Background="#EF4444" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- PAGE 4: ABOUT -->
                    <ScrollViewer x:Name="pageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock x:Name="lblAboutHeader" Text="เกี่ยวกับ TH_DESK (About &amp; Open Source Credits)" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC"/>
                            <TextBlock x:Name="lblAboutDesc" Text="โปรแกรมรีโมทเดสก์ท็อปและตัวจัดการเซิร์ฟเวอร์แบบโอเพนซอร์ส แจกจ่ายฟรีสำหรับทุกคน" FontSize="12.5" Foreground="#94A3B8" Margin="0,4,0,16"/>

                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="18,16" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock x:Name="lblCreatorTitle" Text="ผู้พัฒนาและดูแลโปรเจกต์ (Developer &amp; Maintainer)" FontSize="14.5" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="lblCreatorName" Text="• พัฒนาและดูแลโปรเจกต์โดย: kuromineko" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="lblCreatorRepo" Text="• GitHub Repository: https://github.com/kuromineko/TH_DESK" FontSize="13" Foreground="#E2E8F0" Margin="0,0,0,12"/>
                                    <Button x:Name="btnOpenMyGithub" Content="🔗 เปิดหน้า GitHub ของ TH_DESK (kuromineko/TH_DESK)" Click="BtnOpenMyGithub_Click"
                                            Height="36" HorizontalAlignment="Left" Padding="16,0" Background="#0071FF" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"/>
                                </StackPanel>
                            </Border>

                            <Border Background="#141926" BorderBrush="#222B3E" BorderThickness="1" CornerRadius="12" Padding="18,16">
                                <StackPanel>
                                    <TextBlock x:Name="lblSourceTitle" Text="ที่มาของซอร์สโค้ดต้นฉบับและสัญญาอนุญาต (Upstream &amp; License)" FontSize="14.5" FontWeight="Bold" Foreground="#A78BFA" Margin="0,0,0,8"/>
                                    <TextBlock x:Name="lblLicenseNotice" TextWrapping="Wrap" FontSize="12.5" Foreground="#CBD5E1" LineHeight="20" Margin="0,0,0,12"
                                               Text="โปรแกรม TH_DESK พัฒนาต่อยอดจากโปรเจกต์โอเพนซอร์ส RustDesk และทำงานร่วมกับคอร์เซิร์ฟเวอร์ RustDesk Server OSS (hbbs / hbbr) เผยแพร่ภายใต้สัญญาอนุญาตสาธารณะ GNU Affero General Public License v3.0 (AGPL-3.0)"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnOpenRustDeskGithub" Content="🌐 โค้ดต้นฉบับ RustDesk Official" Click="BtnOpenRustDesk_Click" Height="34" Padding="14,0" Background="#252E42" Foreground="White" FontWeight="SemiBold" Margin="0,0,10,0" Cursor="Hand" BorderThickness="0"/>
                                        <Button x:Name="btnOpenLicense" Content="📜 อ่านสัญญาอนุญาต AGPL-3.0" Click="BtnOpenLicense_Click" Height="34" Padding="14,0" Background="#252E42" Foreground="White" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>